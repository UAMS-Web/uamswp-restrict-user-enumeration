<?xml version="1.0"?>
<!--
	FR5 needs its own process: UAMSWP_RUE_DISABLE is read when the plugin file
	is first included, and a constant cannot be undefined once set. This config
	lives beside the suite it runs rather than in the repo root, so the two
	cannot drift apart.

	Run from the repo root: vendor/bin/phpunit -c tests/killswitch/phpunit.xml.dist
-->
<phpunit
	bootstrap="../bootstrap-killswitch.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	>
	<testsuites>
		<testsuite name="uamswp-restrict-user-enumeration-killswitch">
			<directory prefix="test-" suffix=".php">.</directory>
		</testsuite>
	</testsuites>
</phpunit>
