<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="../vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="bootstrap.php"
         backupGlobals="false"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true"
         beStrictAboutTestsThatDoNotTestAnything="true">
    <!--
        FR5 needs its own process: UAMSWP_RUE_DISABLE is read when the plugin file
        is first included, and a constant cannot be undefined once set. This config
        lives beside the suite it runs rather than in the Integration root, so the
        two cannot drift apart. Run it with `composer test:killswitch`.
    -->
    <testsuites>
        <testsuite name="Killswitch">
            <directory prefix="test-" suffix=".php">.</directory>
        </testsuite>
    </testsuites>
</phpunit>
