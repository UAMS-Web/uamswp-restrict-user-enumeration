<?xml version="1.0"?>
<!--
	FR5 needs its own process: UAMSWP_RUE_DISABLE is read when the plugin file
	is first included, and a constant cannot be undefined once set.
-->
<phpunit
	bootstrap="tests/bootstrap-killswitch.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	>
	<testsuites>
		<testsuite name="uamswp-restrict-user-enumeration-killswitch">
			<directory prefix="test-" suffix=".php">./tests/killswitch</directory>
		</testsuite>
	</testsuites>
</phpunit>
