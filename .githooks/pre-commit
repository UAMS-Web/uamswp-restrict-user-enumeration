#!/bin/sh
#
# pre-commit: refuse a commit that stages a file this list forbids.
#
# Git history is permanent and, in a public repository, readable by anyone, so
# the check that matters most runs here, before the commit exists.
#
# Install once per clone (the hook lives in the repository, git does not run
# it from there by default):
#
#     git config core.hooksPath .githooks
#
# The patterns are extended regular expressions matched case-insensitively
# against each staged path. To allow a file that matches, change the list
# below in the same pull request that adds it.
#
# POSIX sh only. No dependency beyond git.

DENY='
sentinel-key\.php$
wp-config\.php$
\.sql(\.gz)?$
\.(csv|tsv|xlsx?)$
\.env(\.|$)
\.pem$
\.key$
'

# Added, copied, modified and renamed paths in the index. Deleted ones cannot
# leak anything. -z and tr keep a path with a space or a quote intact.
staged=$(git diff --cached --name-only --diff-filter=ACMR -z | tr '\0' '\n')

if [ -z "$staged" ]; then
    exit 0
fi

denied=""

while IFS= read -r pattern; do
    [ -z "$pattern" ] && continue
    hits=$(printf '%s\n' "$staged" | grep -Ei -- "$pattern")
    grc=$?
    # 0 matched, 1 no match, anything else: grep could not use the pattern.
    if [ "$grc" -gt 1 ]; then
        echo "pre-commit: grep rejected the deny pattern $pattern; refusing the commit rather than skipping the guard." >&2
        exit 1
    fi
    if [ -n "$hits" ]; then
        denied="$denied$(printf '%s\n' "$hits" | while IFS= read -r hit; do printf '%s\t%s\n' "$hit" "$pattern"; done)
"
    fi
done <<EOF
$DENY
EOF

if [ -z "$denied" ]; then
    exit 0
fi

echo "" >&2
echo "pre-commit: refusing this commit. A staged file matches the deny list in .githooks/pre-commit:" >&2
printf '%s\n' "$denied" | while IFS="$(printf '\t')" read -r file pattern; do
    [ -z "$file" ] && continue
    echo "    $file    (pattern: $pattern)" >&2
done
echo "" >&2
echo "Unstage it (git restore --staged <file>) and keep it out of the repository." >&2
echo "If the file belongs in the repository, change the deny list in .githooks/pre-commit first." >&2
exit 1
