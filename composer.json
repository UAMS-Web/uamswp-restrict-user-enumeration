{
    "name": "uams-web/uamswp-restrict-user-enumeration",
    "description": "Blocks unauthenticated WordPress username and author-slug enumeration across the UAMS estate.",
    "type": "wordpress-muplugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.1"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "laravel/pint": "^1.32",
        "php-stubs/wordpress-stubs": "6.8",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^9.6",
        "rector/rector": "^2.6",
        "squizlabs/php_codesniffer": "^3.9",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.4",
        "wp-phpunit/wp-phpunit": "~7.1.0",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:legacy",
            "@test:killswitch"
        ],
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "test:legacy": "phpunit -c tests-legacy/phpunit.xml.dist",
        "test:killswitch": "phpunit -c tests-legacy/killswitch/phpunit.xml.dist",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "stan": "phpstan analyse --no-progress --memory-limit=2G",
        "refactor": "rector",
        "refactor:sweep": "rector --clear-cache --config=rector-sweep.php",
        "test:refactor": "rector --dry-run",
        "test:refactor:sweep": "rector --dry-run --clear-cache --config=rector-sweep.php",
        "pint": "pint",
        "test:pint": "pint --test"
    },
    "scripts-descriptions": {
        "test": "Run both suites, each in its own process, so the Unit suite never sees WordPress.",
        "test:unit": "Run the suite that needs no WordPress and no database.",
        "test:integration": "Run the suite that boots WordPress through wp-phpunit against the test database."
    },
    "autoload-dev": {
        "psr-4": {
            "UamswpRestrictUserEnumeration\\Tests\\": "tests/"
        }
    }
}
