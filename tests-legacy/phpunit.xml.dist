<?xml version="1.0"?>
<!--
	The behavioral suite as it stood before the harness reshape: 79 tests
	pinning FR1 through FR7, including the two-gate REST enforcement released
	in v1.1.0.

	It keeps its own config rather than joining phpunit.xml.dist because it
	boots the WordPress test library through tests-legacy/bootstrap.php, and
	PHPUnit takes one bootstrap per configuration file. It stays in
	`composer test` until #8 migrates these tests to Pest: parking them without
	running them would leave the plugin's behavior ungated on four production
	installs.

	The kill-switch tests are excluded here and run from
	tests-legacy/killswitch/phpunit.xml.dist, which needs a separate process
	because UAMSWP_RUE_DISABLE is read when the plugin file is first included.
-->
<phpunit
	bootstrap="bootstrap.php"
	backupGlobals="false"
	colors="true"
	convertErrorsToExceptions="true"
	convertNoticesToExceptions="true"
	convertWarningsToExceptions="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	>
	<testsuites>
		<testsuite name="Legacy">
			<directory prefix="test-" suffix=".php">.</directory>
			<exclude>./killswitch</exclude>
		</testsuite>
	</testsuites>
</phpunit>
